{
  "permissions": {
    "additionalDirectories": [
      "../../plugins/woocommerce"
    ],
    "allow": [
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(wp db drop:*)",
      "Bash(wp db reset:*)"
    ]
  }
}
